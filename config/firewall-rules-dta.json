{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "firewallPolicyName": {
      "type": "string"
    },
    "criticalInfrastructureRuleCollectionGroupName": {
      "type": "string"
    },
    "securityServicesRuleCollectionGroupName": {
      "type": "string"
    },
    "applicationNetworkRuleCollectionGroupName": {
      "type": "string"
    },
    "externalIntegrationsRuleCollectionGroupName": {
      "type": "string"
    },
    "generalRuleCollectionGroupName": {
      "type": "string"
    },
    "criticalInfrastructurePriority": {
      "type": "int"
    },
    "securityServicesPriority": {
      "type": "int"
    },
    "applicationNetworkPriority": {
      "type": "int"
    },
    "externalIntegrationsPriority": {
      "type": "int"
    },
    "generalPriority": {
      "type": "int"
    },
    "dnatOutboundAllowCollectionName": {
      "type": "string"
    },
    "dnatOutboundAllowCollectionPriority": {
      "type": "int"
    },
    "networkOutboundAllowCollectionName": {
      "type": "string"
    },
    "networkOutboundAllowCollectionPriority": {
      "type": "int"
    },
    "applicationOutboundAllowCollectionName": {
      "type": "string"
    },
    "applicationOutboundAllowCollectionPriority": {
      "type": "int"
    },
    "applicationOutboundDenyCollectionName": {
      "type": "string"
    },
    "applicationOutboundDenyCollectionPriority": {
      "type": "int"
    },
    "networkRuleCollectionGroupName": {
      "type": "string"
    },
    "applicationRuleCollectionGroupName": {
      "type": "string"
    },
    "dnatRuleCollectionGroupName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-01-01",
      "name": "[concat(parameters('firewallPolicyName'), '/', parameters('criticalInfrastructureRuleCollectionGroupName'))]",
      "properties": {
        "priority": "[parameters('criticalInfrastructurePriority')]",
        "ruleCollections": []
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-01-01",
      "name": "[concat(parameters('firewallPolicyName'), '/', parameters('securityServicesRuleCollectionGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies/ruleCollectionGroups', parameters('firewallPolicyName'), parameters('criticalInfrastructureRuleCollectionGroupName'))]"
      ],
      "properties": {
        "priority": "[parameters('securityServicesPriority')]",
        "ruleCollections": [
          {
            "name": "[parameters('applicationOutboundDenyCollectionName')]",
            "priority": "[parameters('applicationOutboundDenyCollectionPriority')]",
            "ruleCollectionType": "FirewallPolicyFilterRuleCollection",
            "action": {
              "type": "Deny"
            },
            "rules": [
              {
                "ruleType": "ApplicationRule",
                "name": "BlockSocialMedia",
                "protocols": [
                  {
                    "protocolType": "Https",
                    "port": 443
                  }
                ],
                "sourceAddresses": [
                  "*"
                ],
                "targetFqdns": [
                  "*.facebook.com",
                  "*.instagram.com"
                ],
                "fqdnTags": [],
                "httpHeadersToInsert": [],
                "terminateTLS": false
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-01-01",
      "name": "[concat(parameters('firewallPolicyName'), '/', parameters('applicationNetworkRuleCollectionGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies/ruleCollectionGroups', parameters('firewallPolicyName'), parameters('securityServicesRuleCollectionGroupName'))]"
      ],
      "properties": {
        "priority": "[parameters('applicationNetworkPriority')]",
        "ruleCollections": [
          {
            "name": "[parameters('dnatOutboundAllowCollectionName')]",
            "priority": "[parameters('dnatOutboundAllowCollectionPriority')]",
            "ruleCollectionType": "FirewallPolicyNatRuleCollection",
            "action": {
              "type": "DNAT"
            },
            "rules": [
              {
                "ruleType": "NatRule",
                "name": "DNAT-SSH",
                "ipProtocols": [
                  "TCP"
                ],
                "sourceAddresses": [
                  "*"
                ],
                "destinationAddresses": [
                  "10.0.1.4"
                ],
                "destinationPorts": [
                  "22"
                ],
                "translatedAddress": "10.1.200.10",
                "translatedPort": "22"
              },
              {
                "ruleType": "NatRule",
                "name": "DNAT-WebServer",
                "ipProtocols": [
                  "TCP"
                ],
                "sourceAddresses": [
                  "*"
                ],
                "destinationAddresses": [
                  "10.0.1.4"
                ],
                "destinationPorts": [
                  "80"
                ],
                "translatedAddress": "10.1.200.20",
                "translatedPort": "8080"
              }
            ]
          },
          {
            "name": "[parameters('networkOutboundAllowCollectionName')]",
            "priority": "[parameters('networkOutboundAllowCollectionPriority')]",
            "ruleCollectionType": "FirewallPolicyFilterRuleCollection",
            "action": {
              "type": "Allow"
            },
            "rules": [
              {
                "ruleType": "NetworkRule",
                "name": "AllowSubnet-PL-SN-Outbound",
                "ipProtocols": [
                  "TCP",
                  "UDP"
                ],
                "sourceAddresses": [
                  "10.1.200.0/24"
                ],
                "destinationAddresses": [
                  "*"
                ],
                "destinationPorts": [
                  "80",
                  "443"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-01-01",
      "name": "[concat(parameters('firewallPolicyName'), '/', parameters('externalIntegrationsRuleCollectionGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies/ruleCollectionGroups', parameters('firewallPolicyName'), parameters('applicationNetworkRuleCollectionGroupName'))]"
      ],
      "properties": {
        "priority": "[parameters('externalIntegrationsPriority')]",
        "ruleCollections": [
          {
            "name": "[parameters('applicationOutboundAllowCollectionName')]",
            "priority": "[parameters('applicationOutboundAllowCollectionPriority')]",
            "ruleCollectionType": "FirewallPolicyFilterRuleCollection",
            "action": {
              "type": "Allow"
            },
            "rules": [
              {
                "ruleType": "ApplicationRule",
                "name": "AllowGitHub",
                "protocols": [
                  {
                    "protocolType": "Https",
                    "port": 443
                  }
                ],
                "sourceAddresses": [
                  "10.3.0.0/16"
                ],
                "targetFqdns": [
                  "*.github.com"
                ],
                "fqdnTags": [],
                "httpHeadersToInsert": [],
                "terminateTLS": false
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-01-01",
      "name": "[concat(parameters('firewallPolicyName'), '/', parameters('generalRuleCollectionGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies/ruleCollectionGroups', parameters('firewallPolicyName'), parameters('externalIntegrationsRuleCollectionGroupName'))]"
      ],
      "properties": {
        "priority": "[parameters('generalPriority')]",
        "ruleCollections": [
          {
            "name": "[parameters('applicationOutboundAllowCollectionName')]",
            "priority": "[parameters('applicationOutboundAllowCollectionPriority')]",
            "ruleCollectionType": "FirewallPolicyFilterRuleCollection",
            "action": {
              "type": "Allow"
            },
            "rules": [
              {
                "ruleType": "ApplicationRule",
                "name": "AllowTeams",
                "protocols": [
                  {
                    "protocolType": "Https",
                    "port": 443
                  }
                ],
                "sourceAddresses": [
                  "192.168.50.0/24"
                ],
                "targetFqdns": [
                  "*.teams.microsoft.com"
                ],
                "fqdnTags": [],
                "httpHeadersToInsert": [],
                "terminateTLS": false
              }
            ]
          }
        ]
      }
    }
  ]
}
